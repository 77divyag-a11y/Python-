# First-K sentence summariser

def first_k_summary(text, k=1):
    import re
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())
    return " ".join(sentences[:k])


# Important-word frequency summariser

def important_summary(text, k=1):
    import re
    from collections import Counter

    stop_words = {
        "the", "is", "a", "an", "and", "was",
        "were", "to", "of", "in", "on", "for",
        "but", "with", "it", "near"
    }

    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = [
        word.lower()
        for word in re.findall(r'\b\w+\b', text)
        if word.lower() not in stop_words
    ]

    frequency = Counter(words)

    ranked = []

    for i, sentence in enumerate(sentences):
        sentence_words = [
            word.lower()
            for word in re.findall(r'\b\w+\b', sentence)
            if word.lower() not in stop_words
        ]

        importance = sum(
            frequency[word] for word in sentence_words
        )

        ranked.append((importance, i, sentence))

    selected = sorted(
        ranked, key=lambda x: x[0], reverse=True
    )[:k]

    selected.sort(key=lambda x: x[1])

    return " ".join(item[2] for item in selected)


