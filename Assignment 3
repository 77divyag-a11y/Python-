#Contact List Merging and Duplicate Contact Detection Using Python
import re
from time import perf_counter


# Normalize phone numbers
def normalise_phone(phone):
    digits = re.sub(r"\D", "", phone or "")

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits


# Normalize contact names
def normalise_name(name):
    return " ".join((name or "").lower().split())


# Merge contact lists
def merge_contacts(contact_lists):
    merged = {}
    unmatched = []

    for source in contact_lists:
        for contact in source:
            raw_phone = contact.get("phone", "")
            key = normalise_phone(raw_phone)

            name = contact.get("name", "").strip()
            email = contact.get("email", "").strip().lower()

            if not key:
                unmatched.append({
                    "name": name,
                    "phone": raw_phone,
                    "email": email
                })
                continue

            if key not in merged:
                merged[key] = {
                    "name_variants": set(),
                    "phones": set(),
                    "emails": set()
                }

            if name:
                merged[key]["name_variants"].add(name)

            if raw_phone:
                merged[key]["phones"].add(raw_phone)

            if email:
                merged[key]["emails"].add(email)

    # Prepare final merged results
    result = []

    for key, item in sorted(merged.items()):
        names = sorted(item["name_variants"])

        result.append({
            "normalised_phone": key,
            "display_name": names[0] if names else "Unknown",
            "name_variants": names,
            "phone_numbers": sorted(item["phones"]),
            "emails": sorted(item["emails"])
        })

    return result, unmatched


